# Server Port & Allowed Client CORS Origin
PORT=3000
CLIENT_URL=http://localhost:5173

# Microsoft SQL Server Database Configuration
DB_USER=sa
DB_PASSWORD=your_password_here
DB_SERVER=localhost
DB_NAME=bus_management
DB_PORT=1433
DB_ENCRYPT=false

# Security & JWT Token Key
JWT_SECRET=super_secret_jwt_key_bus_booking_2026
JWT_REFRESH_SECRET=super_secret_refresh_token_key_bus_booking_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Background Jobs (Auto-cancel expired reservations)
CRON_ENABLED=true

# Role-based Database Logins (Principle of Least Privilege / Socket-level RBAC)
DB_ADMIN_USER=login_admin
DB_ADMIN_PASSWORD=your_admin_password_here
DB_STAFF_USER=login_nhanvien
DB_STAFF_PASSWORD=your_staff_password_here
DB_DRIVER_USER=login_taixe
DB_DRIVER_PASSWORD=your_driver_password_here
DB_CUSTOMER_USER=login_khachhang
DB_CUSTOMER_PASSWORD=your_customer_password_here